# Server-side only. Never prefix with NEXT_PUBLIC_ and never commit .env.local.
# Create a free key at https://console.groq.com/keys
GROQ_API_KEY=replace_with_your_groq_api_key

# Model ID, verified against https://console.groq.com/docs/models on 11 Oct 2026.
# Default if unset: openai/gpt-oss-120b (production model, supports JSON output).
# Lighter/faster alternative if you hit free-tier limits: openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-120b
